rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 사용자 프로필 및 서브컬렉션
    match /users/{userId} {
      // 본인 데이터는 모든 권한 (읽기, 쓰기)
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // 친구 추가 및 삭제를 위해 타인이 자신의 UID를 friends 리스트와 friendships 맵에서 업데이트하는 것을 허용
      allow update: if request.auth != null && (
        request.auth.uid == userId || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends', 'friendships']) &&
          (
            // 친구 추가 케이스 (arrayUnion)
            (request.resource.data.friends.size() == resource.data.friends.size() + 1 &&
             request.auth.uid in request.resource.data.friends) ||
            // 친구 삭제 케이스 (arrayRemove)
            (request.resource.data.friends.size() == resource.data.friends.size() - 1 &&
             !(request.auth.uid in request.resource.data.friends))
          )
        )
      );
      
      // 숲코몽 수집 정보 (서브컬렉션)
      match /acquired_soopkomons/{soopId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null;
      }
    }

    // 친구 요청 데이터
    match /friend_requests/{requestId} {
      // 본인이 보냈거나 본인에게 온 요청만 읽기 가능
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      
      // 요청 생성: 로그인 필수 + 보낸 사람 본인 확인
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      
      // 요청 상태 업데이트: 수락/거절은 받는 사람만 가능
      allow update: if request.auth != null && request.auth.uid == resource.data.receiverId;
      
      // 요청 삭제: 관련자만 가능
      allow delete: if request.auth != null && 
        (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
    }

    // 캐릭터 파츠 데이터
    match /character_parts/{allPaths=**} {
      // 모든 인증된 사용자는 캐릭터 구성을 위해 파츠 데이터를 읽을 수 있음
      allow read: if request.auth != null;
      // 쓰기는 시스템 관리자만 가능해야 함 (일단 막아둠)
      allow write: if false;
    }
  }
}
